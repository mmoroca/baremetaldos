diff --git a/src/dos/drive_local.cpp b/src/dos/drive_local.cpp
index 44396d7e..fb3f6727 100644
--- a/src/dos/drive_local.cpp
+++ b/src/dos/drive_local.cpp
@@ -373,7 +373,30 @@ bool localDrive::Rename(char * oldname,char * newname) {
 
 }
 
+// BM-DOS: where the free-space figures come from.
+//
+// Without this, MOUNT of a directory builds the drive with the geometry written in
+// dos_programs.cpp ("512,32,32765,16000": 16 KB clusters, 16000 free clusters =
+// 262,144,000 bytes free) and this function repeats it for ever, so DIR prints the
+// same figure on an empty card and on a full one.
+//
+// Nothing in the core can ask a host filesystem how much room is left, and the port
+// can.  It is asked only when MOUNT did not pin the numbers itself (SetSpaceFromPort),
+// so -freesize and -size go on doing exactly what they did, and when the port has no
+// answer -no card- the four numbers of the mount line stand.
+extern "C" bool bare_storage_dos_space(unsigned int *pBytesPerSector,unsigned int *pSectorsPerCluster,unsigned int *pTotalClusters,unsigned int *pFreeClusters);
+
 bool localDrive::AllocationInfo(Bit16u * _bytes_sector,Bit8u * _sectors_cluster,Bit16u * _total_clusters,Bit16u * _free_clusters) {
+	if (bSpaceFromPort) {
+		unsigned int nBytesPerSector=0,nSectorsPerCluster=0,nTotalClusters=0,nFreeClusters=0;
+		if (bare_storage_dos_space(&nBytesPerSector,&nSectorsPerCluster,&nTotalClusters,&nFreeClusters)) {
+			*_bytes_sector=(Bit16u)nBytesPerSector;
+			*_sectors_cluster=(Bit8u)nSectorsPerCluster;
+			*_total_clusters=(Bit16u)nTotalClusters;
+			*_free_clusters=(Bit16u)nFreeClusters;
+			return true;
+		}
+	}
 	*_bytes_sector=allocation.bytes_sector;
 	*_sectors_cluster=allocation.sectors_cluster;
 	*_total_clusters=allocation.total_clusters;
