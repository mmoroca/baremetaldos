+// BM-DOS: a whole run of sectors in one call; see ReadSectorsHost() in
+// cdrom_image.cpp.  isoFile::Read() uses it for the whole sectors of a request.
+bool isoDrive :: readSectors(Bit8u *buffer, Bit32u sector, Bit16u num) {
+	return CDROM_Interface_Image::images[subUnit]->ReadSectorsHost(buffer, sector, num);
+}
