+// BM-DOS: the contiguous-run read of ReadSectors(), into a host buffer instead of
+// emulated memory.  It exists because of who reads an ISO: "IMGMOUNT -t iso"
+// builds an isoDrive (drive_iso.cpp), and isoFile::Read() went through
+// ReadSector() one 2048-byte sector at a time - one seekg() + one read() on the
+// image file each, 30 of them for a 60 KB COPY.  With this, drive_iso.cpp asks
+// for the whole run in a single read().  Same conditions as ReadSectors(): the
+// run must lie inside one track and the track must store the sector size being
+// asked for, so that the bytes are contiguous in the file.
+bool CDROM_Interface_Image::ReadSectorsHost(Bit8u *buffer, unsigned long sector, unsigned long num)
+{
+	if (num == 0) return true;
+
+	int track = GetTrack(sector);
+	if (track > 0 && track == GetTrack(sector + num - 1)) {
+		Track &t = tracks[track - 1];
+		if (t.sectorSize == COOKED_SECTOR_SIZE) {
+			int seek = t.skip + (sector - t.start) * t.sectorSize;
+			if (t.file->read(buffer, seek, (int)(num * COOKED_SECTOR_SIZE)))
+				return true;
+		}
+	}
+
+	// Not one contiguous run of cooked sectors, or the read failed: fall back to
+	// the per-sector path, which is the one that reports the sector that fails.
+	bool success = true;
+	for (unsigned long i = 0; i < num; i++) {
+		success = ReadSector(&buffer[i * COOKED_SECTOR_SIZE], false, sector + i);
+		if (!success) break;
+	}
+	return success;
+}
